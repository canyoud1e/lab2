#include <iostream>
using namespace std;

int main() {
    int A, B, C;
    cin >> A >> B >> C;

    if ((A > 0 && B > 0 && C <= 0) || 
        (A > 0 && C > 0 && B <= 0) || 
        (B > 0 && C > 0 && A <= 0)) {
