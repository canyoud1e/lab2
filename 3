#include <iostream>
#include <cmath>
using namespace std;

int main() {
    double a, b, h;
    cin >> a >> b >> h;

    cout << "x\ty" << endl;
    for (double x = a; x <= b + h / 2; x += h) {
        double y = sin(x) + fabs(x) + pow(2, x);
        cout << x << "\t" << y << endl;
    }

    return 0;
}
